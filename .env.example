# ── Site ────────────────────────────────────────────────────
# Local development:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (canonical):
# NEXT_PUBLIC_SITE_URL=https://www.bkschoolofresearch.org

# ── CMS driver ──────────────────────────────────────────────
# fs (default) = local .data/cms-database.json — admin + public stay in sync
# mongo = MongoDB (set MONGODB_URI) — REQUIRED for durable Vercel production
CMS_DRIVER=fs
# NEXT_PUBLIC_CMS_MODE=mongo

# Admin login (required for mongo; also locks fs when set)
# CMS_ADMIN_EMAIL=admin@example.com
# CMS_ADMIN_PASSWORD=change-me-strong-password
# Optional API/session token (scripts: x-cms-admin-secret). Defaults to password if unset.
# CMS_ADMIN_SECRET=change-me-bksr-admin-secret

# ── MongoDB (when CMS_DRIVER=mongo) ─────────────────────────
# MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/bksr?retryWrites=true&w=majority
# MONGODB_DB=bksr

# ── Cloudinary (uploads + next/image delivery) ──────────────
# CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=   # same as cloud name (client loader)
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=bksr/media

# ── Resend (invite, OTP, contact form) ──────────────────────
# FROM must be a verified Resend domain (not @gmail.com).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=BK School of Research <onboarding@resend.dev>
# CONTACT_INBOX_EMAIL=info@bkschoolofresearch.org
